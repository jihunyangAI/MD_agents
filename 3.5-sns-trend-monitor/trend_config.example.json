{
  "topics": [
    "AI",
    "LLM",
    "개발자도구",
    "테크"
  ],
  "collection": {
    "search_tool": "claude_websearch",
    "search_tool_fallback": [
      "tavily",
      "nitter_rss"
    ],
    "linkedin_post_count": 30,
    "linkedin_language": "ko",
    "linkedin_query_site": "site:linkedin.com/posts",
    "linkedin": {
      "include_domains": [
        "linkedin.com"
      ],
      "url_filter": "linkedin.com/posts/",
      "time_range": "week",
      "search_tool_by_mode": {
        "claude_code": "claude_websearch",
        "python_schedule": "tavily"
      },
      "queries_ko": {
        "AI": [
          "site:linkedin.com/posts AI 트렌드",
          "site:linkedin.com/posts 인공지능"
        ],
        "LLM": [
          "site:linkedin.com/posts LLM",
          "site:linkedin.com/posts 거대언어모델"
        ],
        "개발자도구": [
          "site:linkedin.com/posts 개발자도구",
          "site:linkedin.com/posts 개발 생산성 도구"
        ],
        "테크": [
          "site:linkedin.com/posts 테크 트렌드",
          "site:linkedin.com/posts IT 기술 동향"
        ]
      },
      "queries_en_fallback": {
        "AI": [
          "site:linkedin.com/posts AI trends"
        ],
        "LLM": [
          "site:linkedin.com/posts LLM"
        ],
        "개발자도구": [
          "site:linkedin.com/posts developer tools"
        ],
        "테크": [
          "site:linkedin.com/posts tech trends"
        ]
      },
      "korean_priority": {
        "sort_hangul_first": true,
        "fill_with_english_if_below_count": true
      },
      "use_fields": [
        "title",
        "snippet",
        "url"
      ],
      "on_shortage": "collected_only"
    },
    "x_result_count": 50,
    "nitter_rss_base": "https://nitter.privacydev.net",
    "x": {
      "use_paid_api": false,
      "include_domains": [
        "x.com",
        "twitter.com"
      ],
      "url_filter": "/status/",
      "time_range": "week",
      "search_tool_by_mode": {
        "claude_code": "claude_websearch",
        "python_schedule": "tavily"
      },
      "queries_ko": {
        "AI": [
          "site:x.com AI 트렌드",
          "site:x.com 인공지능"
        ],
        "LLM": [
          "site:x.com LLM",
          "site:x.com 거대언어모델"
        ],
        "개발자도구": [
          "site:x.com 개발자도구",
          "site:x.com 개발 생산성 도구"
        ],
        "테크": [
          "site:x.com 테크 트렌드",
          "site:x.com IT 기술 동향"
        ]
      },
      "queries_en_fallback": {
        "AI": [
          "site:x.com AI trends"
        ],
        "LLM": [
          "site:x.com LLM"
        ],
        "개발자도구": [
          "site:x.com developer tools"
        ],
        "테크": [
          "site:x.com tech trends"
        ]
      },
      "korean_priority": {
        "sort_hangul_first": true,
        "fill_with_english_if_below_count": true
      },
      "nitter_fallback": {
        "enabled": true,
        "base_url": "https://nitter.privacydev.net",
        "rss_path": "/search/rss?f=tweets&q={query}",
        "query_terms": {
          "AI": "AI 트렌드",
          "LLM": "LLM",
          "개발자도구": "개발자도구",
          "테크": "테크 트렌드"
        },
        "timeout_seconds": 15,
        "max_attempts": 1
      },
      "use_fields": [
        "title",
        "snippet",
        "url"
      ],
      "on_all_failed": "linkedin_only",
      "on_shortage": "collected_only"
    },
    "collect_period_days": 7,
    "primary_queries": {
      "x": "{topic} new AI tool release OR launch OR update 2026 site:x.com",
      "linkedin": "site:linkedin.com/posts \"{topic}\" new release OR launch OR update 2026"
    },
    "tavily_max_results_per_call": 20,
    "collect_interval_hours": 24
  },
  "analysis": {
    "top_keywords_count": 20,
    "trending_rise_threshold": 3,
    "min_mentions_per_topic": 2,
    "categories": [
      "급상승",
      "상승",
      "하락",
      "신규"
    ],
    "noise_filter": {
      "exclude_keywords": [
        "니케",
        "NIKKE",
        "POCO",
        "REDMI",
        "Xiaomi",
        "Galaxy",
        "iPhone",
        "Airbnb",
        "엑셀",
        "Excel",
        "hallmark",
        "Signal",
        "BLA",
        "iMIS",
        "Semrush",
        "Ahrefs Brand Radar",
        "Yoast",
        "Rank Math"
      ],
      "exclude_patterns": [
        "^M\\d{3}[A-Z]{2}$",
        "^[A-Z]{1,3}\\d{3,}[A-Z]{0,3}$",
        "^\\d+$"
      ],
      "aliases": {
        "클로드 코드": "Claude Code",
        "클로드": "Claude",
        "챗GPT": "ChatGPT",
        "챗지피티": "ChatGPT",
        "제미나이": "Gemini",
        "codex": "Codex"
      }
    },
    "keyword_extractor": "claude_cli",
    "claude_model": "haiku",
    "openai_model": "gpt-5.4-mini"
  },
  "report": {
    "html_path": "data/trend_report.html",
    "telegram_path": "data/telegram_summary.txt",
    "rising_top_n": 5,
    "telegram_rising_n": 2,
    "telegram_new_n": 3,
    "topic_emoji": {
      "AI": "🤖",
      "LLM": "🧠",
      "개발자도구": "🛠️",
      "테크": "💻"
    },
    "default_emoji": "📌"
  },
  "schedule": {
    "report_day": "monday",
    "report_time": "18:00",
    "task_name": "SNSTrendMonitor-Weekly",
    "log_retention_weeks": 12
  },
  "subscribers": [
    "your-email@example.com"
  ],
  "email": {
    "enabled": true,
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 587,
    "gmail_user": "${GMAIL_ADDRESS}",
    "gmail_app_password": "${GMAIL_APP_PASSWORD}",
    "use_bcc": true,
    "subject_format": "SNS 트렌드 위클리 | {date} - {topics} 급상승 키워드",
    "topics_joiner": "·",
    "max_attempts": 2
  },
  "telegram": {
    "telegram_alert": true,
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CHAT_ID}",
    "max_message_length": 4000
  },
  "api_keys": {
    "tavily_api_key": "${TAVILY_API_KEY}",
    "openai_api_key": "${OPENAI_API_KEY}"
  }
}
